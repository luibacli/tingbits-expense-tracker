# Copy to .env and fill in. Never commit .env.

# MongoDB connection string (Atlas: Database > Connect > Drivers). Include the database name, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bacli-expenses?retryWrites=true&w=majority
MONGODB_URI=

# 32+ random characters used to encrypt the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=
